# Template .env — salin jadi .env dan isi nilainya
# ⚠️ JANGAN pernah commit file .env ke git!

# Token bot dari https://discord.com/developers/applications (tab Bot)
TOKEN=your_bot_token_here

# Application ID (Developer Portal → General Information)
CLIENT_ID=your_client_id_here

# ID server untuk testing (opsional). Kalau diisi, `npm run deploy` mendaftarkan
# command hanya ke server ini dan langsung aktif. Kosongkan untuk daftar global.
GUILD_ID=

# Warna embed default (opsional)
EMBED_COLOR=#5865F2
